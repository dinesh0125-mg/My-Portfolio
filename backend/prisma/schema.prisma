generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id           String          @id @default(uuid())
  name         String
  email        String          @unique
  passwordHash String
  role         String          @default("ADMIN")
  isActive     Boolean         @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  activities   AdminActivity[]

  @@map("admins")
}

model Hero {
  id                   Int      @id @default(autoincrement())
  name                 String
  title                String
  subtitle             String?
  description          String   @db.Text
  profileImageUrl      String?
  profileImagePublicId String?
  primaryButtonText    String   @default("View My Projects")
  primaryButtonLink    String   @default("#projects")
  secondaryButtonText  String   @default("Download Resume")
  secondaryButtonLink  String   @default("/Dinesh_M_Resume.pdf")
  resumeUrl            String?
  resumePublicId       String?
  badge                String?
  location             String?
  updatedAt            DateTime @updatedAt

  @@map("hero")
}

model About {
  id             Int              @id @default(autoincrement())
  heading        String
  description    String           @db.Text
  imageUrl       String?
  imagePublicId  String?
  additionalInfo Json?
  updatedAt      DateTime         @updatedAt
  highlights     AboutHighlight[]

  @@map("about")
}

model AboutHighlight {
  id           Int      @id @default(autoincrement())
  aboutId      Int
  title        String
  description  String   @db.Text
  icon         String?
  displayOrder Int      @default(0)
  about        About    @relation(fields: [aboutId], references: [id], onDelete: Cascade)

  @@index([aboutId])
  @@map("about_highlights")
}

model Service {
  id           Int      @id @default(autoincrement())
  title        String
  description  String   @db.Text
  icon         String   @default("Layers")
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("services")
}

model Project {
  id                  Int                 @id @default(autoincrement())
  title               String
  slug                String              @unique
  category            String
  shortDescription    String              @db.Text
  description         String              @db.Text
  problemSolved       String?             @db.Text
  myContribution      String?             @db.Text
  developmentApproach String?             @db.Text
  imageUrl            String?
  imagePublicId       String?
  githubUrl           String?
  liveDemoUrl         String?
  featured            Boolean             @default(false)
  displayOrder        Int                 @default(0)
  isActive            Boolean             @default(true)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  technologies        ProjectTechnology[]

  @@map("projects")
}

model Technology {
  id       Int                 @id @default(autoincrement())
  name     String              @unique
  category String?
  projects ProjectTechnology[]

  @@map("technologies")
}

model ProjectTechnology {
  projectId    Int
  technologyId Int
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  technology   Technology @relation(fields: [technologyId], references: [id], onDelete: Cascade)

  @@id([projectId, technologyId])
  @@index([technologyId])
  @@map("project_technologies")
}

model Skill {
  id           Int      @id @default(autoincrement())
  name         String
  category     String
  icon         String?
  note         String?
  highlight    Boolean  @default(false)
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("skills")
}

model Experience {
  id               Int      @id @default(autoincrement())
  jobTitle         String
  company          String
  startDate        String
  endDate          String
  period           String
  location         String?
  summary          String?  @db.Text
  responsibilities Json?
  technologies     Json?
  displayOrder     Int      @default(0)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("experience")
}

model Education {
  id           Int      @id @default(autoincrement())
  degree       String
  institution  String
  startYear    String
  endYear      String
  duration     String?
  cgpa         String
  description  String?  @db.Text
  coursework   Json?
  location     String?
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("education")
}

model Certificate {
  id                       Int      @id @default(autoincrement())
  title                    String
  organization             String
  year                     String
  description              String?  @db.Text
  certificateImageUrl      String?
  certificateImagePublicId String?
  certificateUrl           String?
  credentialId             String?
  skills                   Json?
  displayOrder             Int      @default(0)
  isActive                 Boolean  @default(true)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@map("certificates")
}

model Process {
  id           Int      @id @default(autoincrement())
  stepNumber   Int
  title        String
  description  String   @db.Text
  icon         String?
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("process_steps")
}

model Pricing {
  id           Int      @id @default(autoincrement())
  planName     String
  priceLabel   String
  description  String?  @db.Text
  features     Json?
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("pricing_plans")
}

model ContactInfo {
  id               Int      @id @default(autoincrement())
  email            String
  phone            String
  location         String
  linkedin         String
  github           String
  otherSocialLinks Json?
  updatedAt        DateTime @updatedAt

  @@map("contact_info")
}

model ContactMessage {
  id          Int      @id @default(autoincrement())
  name        String
  email       String
  projectType String?
  message     String   @db.Text
  status      String   @default("NEW")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("contact_messages")
}

model Settings {
  id                 Int      @id @default(autoincrement())
  siteTitle          String   @default("Dinesh M | Full Stack Developer")
  metaDescription    String   @db.Text
  faviconUrl         String?
  faviconPublicId    String?
  ogImageUrl         String?
  ogImagePublicId    String?
  resumeUrl          String?
  resumePublicId     String?
  updatedAt          DateTime @updatedAt

  @@map("settings")
}

model AdminActivity {
  id        Int      @id @default(autoincrement())
  adminId   String?
  action    String
  entity    String
  entityId  String?
  details   String?
  createdAt DateTime @default(now())
  admin     Admin?   @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([adminId])
  @@map("admin_activities")
}
